# ---------------------------------------------------------------------------
# Lanka MicroJob - environment template
#
#   cp .env.example .env        then change every value before deploying
#
# docker compose reads this file automatically. Kubernetes uses k8s/secret.yaml
# (create it from these same keys). Jenkins reads the matching credentials from
# the Jenkins credential store, never from this file.
#
# NOTHING here may contain a real production secret - .env is git-ignored.
# ---------------------------------------------------------------------------

# --- PostgreSQL (shared by every service) ----------------------------------
POSTGRES_DB=lanka_microjob
POSTGRES_USER=lanka
POSTGRES_PASSWORD=change-me-local-only

# --- Spring datasource (consumed by the Java services) ---------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/lanka_microjob
SPRING_DATASOURCE_USERNAME=lanka
SPRING_DATASOURCE_PASSWORD=change-me-local-only

# --- Security --------------------------------------------------------------
# HS256 key used by user-service, job-service, matching-service and broker-service.
# Must be identical everywhere or tokens will not validate. Minimum 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
JWT_EXPIRATION_MINUTES=480

# Service-to-service token. job/user/broker services send it in X-Internal-Token
# when publishing notifications; notification-service rejects calls without it.
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token

# Applied server-side to the real job pay for broker-managed placements.
BROKER_COMMISSION_RATE=0.075

# --- Bootstrap admin account (created only if it does not exist yet) -------
ADMIN_DEFAULT_EMAIL=admin@lanka.lk
ADMIN_DEFAULT_PASSWORD=change-me-admin
ADMIN_DEFAULT_NAME=Platform Admin

# --- Demo data -------------------------------------------------------------
# true seeds 6 open jobs in job-service, BRK-0001 in broker-service and demo
# worker/employer accounts in user-service. Set to false for anything real.
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=demo1234

# --- Notification providers (simulated in this project) --------------------
NOTIFICATION_PROVIDERS=simulated-email,simulated-sms

# --- Gateway CORS ----------------------------------------------------------
# Comma-separated list. Use the exact frontend origin(s); "*" is dev-only.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend build --------------------------------------------------------
# Leave empty for same-origin deployment (nginx proxies to the gateway).
# Set only when the browser must reach the gateway on another host.
VITE_API_BASE=
